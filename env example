# ============================================================
# NetBox-to-GRENML Topology Converter — Environment Variables
# ============================================================
#
# Copy this file to `.env` at the project root.
# Loaded automatically if python-dotenv is installed
# (pip install python-dotenv), or export the variables
# manually before running.
#
# Boolean values accepted: 1, true, yes, on  (case-insensitive)
# Set values (comma-separated): no extra spaces
#   e.g.: "status,tags"
#
# CLI flags (--url, --token, --format etc.) take precedence
# over these variables when provided.


# ============================================================
# 1. EXECUTION MODE
# ============================================================
# Pipeline output format.
#   grenml  — generate GRENML file (.xml) only
#   netbox  — export to target NetBox only
#   both    — generate GRENML and export to NetBox
# Default: grenml
EXPORT_FORMAT=both


# ============================================================
# 2. SOURCE NETBOX
# ============================================================
# Base URL of the source NetBox API.
# Must end with /api/
# Default: https://netbox.gp4l.nmaas.eu/api/
NETBOX_SOURCE_URL=https://netbox.gp4l.nmaas.eu/api/

# Source API authentication token.
# Generate at: NetBox → Admin → API Tokens
# Default: (empty — required)
NETBOX_SOURCE_TOKEN=

# Number of records per page in API requests.
# Higher values reduce the number of requests; lower values
# use less memory.
# Default: 1000
NETBOX_SOURCE_PAGE_SIZE=1000


# ============================================================
# 3. DEVICE FILTERS
# ============================================================
# Controls which devices are included in the topology.
# If unset, uses the built-in default filters (see below).
# If set to an empty string (DEVICE_FILTERS=), accepts ALL
# devices (no filtering).
#
# SYNTAX:
#   Groups separated by "|" (pipe) — OR between groups.
#   Each group starts with an optional logic prefix:
#     "or:"  — filters within the group combined with OR
#     "and:" — filters within the group combined with AND (default)
#   Followed by comma-separated filter expressions.
#
# FILTER EXPRESSION:
#   field=value   → exact match
#   field~value   → partial match (contains)
#
# The "field" is a dot-path into the device JSON returned by
# the NetBox API. Common fields:
#   role.slug          — device role slug
#   status.value       — status (active, planned, staged...)
#   tags.slug          — tag slugs (list; tests each element)
#   site.slug          — site slug
#   tenant.slug        — tenant slug
#   platform.slug      — platform slug
#   manufacturer.slug  — manufacturer slug (via device_type)
#   name               — device name
#
# EXAMPLES:
#
#   Backbone routers only (any of these roles):
#   DEVICE_FILTERS=or:role.slug=aggregation,role.slug=provider-edge,role.slug=border,role.slug=core-router
#
#   Active devices tagged "core" (both conditions required):
#   DEVICE_FILTERS=and:tags.slug~core,status.value=active
#
#   Two groups combined (OR between them):
#   DEVICE_FILTERS=or:role.slug=aggregation,role.slug=provider-edge|and:tags.slug~core,status.value=active
#   → Accepts device if: (role is aggregation OR provider-edge) OR (has tag core AND is active)
#
#   Devices from a specific site:
#   DEVICE_FILTERS=and:site.slug=datacenter-sp,status.value=active
#
#   Devices whose name contains "router":
#   DEVICE_FILTERS=or:name~router
#
#   Accept ALL devices (no filtering):
#   DEVICE_FILTERS=
#
# Default (built into code):
#   or:role.slug=aggregation,role.slug=provider-edge,role.slug=border,role.slug=core-router,role.slug=gp4l-node|and:tags.slug~core,status.value=active
DEVICE_FILTERS=and:role.slug=gp4l-node,status.value=active|and:tags.slug~core,status.value=active


# ============================================================
# 4. TARGET NETBOX
# ============================================================
# Base URL of the target NetBox API for topology export.
# Used only when EXPORT_FORMAT=netbox or both.
# Default: (empty — required when exporting to NetBox)
NETBOX_TARGET_URL=http://usuario.df.testbeds.rnp.br:14008/api/

# Target API authentication token.
# Default: (empty — required when exporting to NetBox)
NETBOX_TARGET_TOKEN=

# Skip the PURGE step on the target NetBox before creating
# objects. Useful for incremental runs.
#   true  — do not purge, keep existing data
#   false — purge everything first (PURGE → SCAFFOLD → CREATE)
# Default: false
NETBOX_TARGET_NO_PURGE=false

# Dry-run mode: simulates the export without writing to the
# target NetBox. Useful for validation.
#   true  — log actions only, no write requests
#   false — execute normally
# Default: false
NETBOX_TARGET_DRY_RUN=false


# ============================================================
# 5. AGGREGATION
# ============================================================
# Aggregate nodes by owner (tenant).
# Nodes with the same owner are merged into one.
# Default: false
AGGREGATE_BY_OWNER=false

# Aggregate nodes by site.
# Nodes at the same site are merged into one.
# Default: false
AGGREGATE_BY_SITE=false

# Remove nodes that have no links after the build.
# Default: false
REMOVE_UNLINKED_NODES=false


# ============================================================
# 6. ANONYMIZATION
# ============================================================
# Anonymize geographic coordinates (latitude/longitude).
# Replaces with generic values.
# Default: false
ANONYMIZE_LOCATION=false

# Anonymize extra device fields (manufacturer, model, serial,
# etc.). Fields listed in ANONYMIZATION_EXCEPTIONS are preserved.
# Default: false
ANONYMIZE_FIELDS=false

# Anonymize interface names.
# Replaces with sequential names using the prefix defined
# in ANONYMIZE_INTERFACE_PREFIX.
#   Example: if-1, if-2, if-3 ...
# Default: false
ANONYMIZE_INTERFACES=true

# Prefix used for anonymized interface names.
# Only takes effect when ANONYMIZE_INTERFACES=true.
# Default: if-
ANONYMIZE_INTERFACE_PREFIX=if-

# Generate fictitious IPs (point-to-point /31 per link +
# loopback /32 per device) instead of using real IPs.
# Default: true
ANONYMIZE_IPS=true

# Base address for sequential anonymous IP generation.
# The range is consumed sequentially starting from this address.
# Only takes effect when ANONYMIZE_IPS=true.
# Default: 192.168.0.0
ANONYMIZE_IP_BASE=10.0.0.0

# Fields that will NOT be anonymized even when
# ANONYMIZE_FIELDS=true. Comma-separated list.
# Default: status,tags
ANONYMIZATION_EXCEPTIONS=status,tags


# ============================================================
# 7. INTERNAL CONSTANTS
# ============================================================
# Device JSON keys already handled by the topology builder
# and excluded from "extra fields". Comma-separated list.
# Default: id,name,tenant,site,location,latitude,longitude,
#          url,display_url,display
HANDLED_KEYS=id,name,tenant,site,location,latitude,longitude,url,display_url,display

# ID and name of the generic owner, used when a device has
# no tenant defined.
# Default: urn:org:generic-owner1
GENERIC_OWNER_ID=urn:org:generic-owner1
# Default: generic-owner
GENERIC_OWNER_NAME=generic-owner

# Slug of the device role created on the target NetBox for
# exported devices.
# Default: gp4l-node
DEVICE_ROLE_SLUG=gp4l-node